# Railway tự inject DATABASE_URL khi bạn add Postgres add-on trong cùng project.
# Để trống hoặc bỏ dòng này khi chạy local -- sẽ tự dùng file sqlite ./local_dev.db
DATABASE_URL=

# Chuỗi bí mật tự chọn -- dùng để chặn người ngoài xem/tải audio nếu lỡ đoán được URL.
# Đặt cùng giá trị này ở frontend (NEXT_PUBLIC_AUDIO_KEY).
AUDIO_ACCESS_KEY=change-me-to-a-random-string

# Domain frontend Vercel, cách nhau bởi dấu phẩy nếu nhiều domain (preview + production).
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
