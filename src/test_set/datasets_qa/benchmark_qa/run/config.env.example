# =============================================================================================
# Mẫu cấu hình cho benchmark_qa.sh.
#
# CÁCH DÙNG: copy file này thành `run/.env` (đã bị .gitignore) rồi điền giá trị thật.
# `benchmark_qa.sh` sẽ tự source `run/.env` (và `.env` ở gốc repo nếu có) trước khi chạy.
#
# Token BẮT BUỘC ở đây (KHÔNG truyền qua CLI flag):
#   HF_TOKEN          -- đọc dữ liệu từ HuggingFace (fetch-speech, fetch-speech-zip)
#   HF_WRITE_TOKEN    -- tạo PR lên HuggingFace (sound --push, push-hf)
#
# Các biến còn lại đều có default hợp lý; chỉ cần khai báo khi muốn thay đổi.
# KHÔNG commit file .env (đã có trong .gitignore).
# =============================================================================================

# --- Bắt buộc (điền giá trị thật) ---
HF_TOKEN=
HF_WRITE_TOKEN=

# --- Vị trí chạy ---
# LOCATION=drive                 # "drive" (Colab/Google Drive) hoặc "local" (máy người dùng)
# REPO_DIR=/content/ViettelSimultaneousSpeechTranslationModels

# --- Đường dẫn dữ liệu (default: Drive) ---
# QA_DATASETS_DIR=/content/drive/MyDrive/it/vdt/voice_agent_for_edge_device/datasets/public/qa_datasets
# SERVICE_ACCOUNT_JSON=/content/drive/MyDrive/it/vdt/voice_agent_for_edge_device/gemini_service_account.json
# KNOWLEDGE_DIR=                  # mặc định: QA_DATASETS_DIR/benchmark_qa/knowledge (drive)
                                  #           CODE_SWITCHING_DIR             (local)
# FULL_TRANSCRIPTS_JSON_PATH=     # mặc định: QA_DATASETS_DIR/benchmark_qa/speech/speech_sources.jsonl
# RELEASE_HF_TRANSCRIPTS_JSON_PATH=  # mặc định: .../speech/speech_sources.jsonl (cùng 1 file)
# VIETNAMESE_SPEECH_QA_LOCAL_DIR= # mặc định: QA_DATASETS_DIR/Vietnamese-Speech-QA

# --- Repo HuggingFace ---
# HF_SPEECH_REPO=anhnbd2005/Vietnamese-Speech-QA
# HF_SOUND_REPO=anhnbd2005/Vietnamese-Audio-QA

# --- Debate + lọc ---
# DEBATE_MODE=api                # "api" (2 API tự debate) hoặc "manual" (copy-paste; chạy y hệt ở các bước sau)
# LƯU Ý: MODEL + ENDPOINT đã ĐỊNH NGHĨA TRONG CODE (auto_model_relay.DEFAULT_*):
#   debate rẻ (ag/gemini-3.6-flash-low / cx/gpt-5.5), lọc cuối khoẻ (ag/gemini-3.8-flash-high / cx/gpt-5.6-luna),
#   base_url http://localhost:20128/v1. Chỉ khai báo dưới đây khi muốn GHI ĐÈ.
# GEMINI_MODEL=
# OPENAI_MODEL=
# GEMINI_BASE_URL=               # override base_url Gemini
# OPENAI_BASE_URL=               # override base_url OpenAI
# OPENAI_API_KEY_FILE=           # file key OpenAI-compatible (thay cho .env)
# ENV_FILE=                      # file .env (chỉ cần API key, không cần base_url/model)
# GEMINI_API_KEY=                # khi DEBATE_MODE=api + LOCAL
# OPENAI_API_KEY=                # khi DEBATE_MODE=api + LOCAL
